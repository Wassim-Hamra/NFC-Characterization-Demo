# NFC Characterization Workbench — environment configuration
# Copy this file to .env and fill in your values

# Optional: Gemini API key for LLM-synthesised answers on the AI Investigation page
# Free tier available at: https://aistudio.google.com/app/apikey
# Without this key, the app runs in retrieval-only mode (fully functional)
GOOGLE_API_KEY=

# Optional: Override the number of synthetic records generated
# NFC_RECORDS=5000
